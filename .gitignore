@'
# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js

# ---------- Build output ----------
dist/
dist-ssr/
build/
out/
*.local

# ---------- Vite cache ----------
.vite/
.vite-cache/
node_modules/.vite/

# ---------- Electron ----------
release/
electron-dist/
*.asar

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- OS files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------- C-Plane specific ----------
*.cplane
!examples/*.cplane

# ---------- Tests ----------
coverage/
.nyc_output/
'@ | Out-File -FilePath .gitignore -Encoding utf8NoBOM